# =============================================================================
# Cockpit Backend — environment. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets.
# =============================================================================

# --- API ---
APP_ENV=dev                       # dev | prod
API_HOST=0.0.0.0
API_PORT=8100                     # free port on the server (nginx proxies to this)
API_BIND=0.0.0.0                  # host interface to publish the API on.
                                  # In prod set to 127.0.0.1 so ONLY nginx can
                                  # reach it (no public, unauthenticated access).
CORS_ORIGINS=http://localhost:8765,http://localhost:3000

# --- Cockpit business DB (Dockerized Postgres: studios, documents, jobs) ---
# In docker-compose the host is the service name `cockpit-db`.
COCKPIT_DATABASE_URL=postgresql+asyncpg://cockpit:cockpit@cockpit-db:5432/cockpit

# --- Vector DB (Dockerized Postgres + pgvector: chunks + embeddings) ---
VECTOR_DATABASE_URL=postgresql+asyncpg://vector:vector@cockpit-vectordb:5432/vector
EMBEDDING_DIM=1024                # must match the migration + the embedding model

# --- Shared identity/credits DB (the EXISTING native `octopilot` Postgres) ---
# Source of truth for users + credits + api_keys + system_settings. Do NOT copy
# this data into Cockpit — read it here. See README "Database strategy".
# The octopilot PG listens on 127.0.0.1:5432 on the server; from a container use
# the host gateway (prod compose sets extra_hosts host.docker.internal).
# Leave blank in local dev to run without it (credits/LLM key fall back to env).
SHARED_DATABASE_URL=

# --- Object storage (MinIO in dev; S3-compatible in prod) ---
OBJECT_STORE_ENDPOINT=http://cockpit-minio:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=cockpit-rag
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_FORCE_PATH_STYLE=true

# --- Embeddings ---
# sentence-transformers  -> real local model (downloads weights, needs torch)
# fallback               -> deterministic hash embedder (no model; dev/tests only)
EMBEDDINGS_BACKEND=fallback
EMBEDDINGS_MODEL=BAAI/bge-m3

# --- Auth (Firebase — reuse Octopilot's Firebase project) ---
# ID tokens are verified against Google's public keys (NO service-account JSON,
# same method as octopilot). Just set the project id. Blank => verification off,
# API falls back to X-User-Id (dev).
FIREBASE_PROJECT_ID=          # octopilot's project, e.g. octopilot-ai-7b29e
FIREBASE_CREDENTIALS=         # optional/unused (kept for ADC back-compat)
ALLOW_DEV_USER_HEADER=true          # set false in prod to require Firebase tokens

# --- LLM generation (OpenRouter, OpenAI-compatible) ---
# If SHARED_DATABASE_URL is set, the key is read from the octopilot `api_keys`
# table (provider=openrouter) and the model from `system_settings.primary_model`.
# These env vars are the override / local-dev fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-opus-4.6

EMBED_SERVICE_URL=http://127.0.0.1:8091
SEARCH_SERVICE_URL=http://127.0.0.1:8092
REDIS_URL=redis://127.0.0.1:6379/0

# --- RAG tuning ---
RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=8                       # candidates retrieved before rerank
RAG_CONTEXT_K=5                   # chunks sent to the LLM
