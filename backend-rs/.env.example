# Firebase project whose ID tokens are accepted (same one octopilot uses).
# Leave empty to disable auth in local dev (the X-User-Id header is trusted).
FIREBASE_PROJECT_ID=octopilot-ai-7b29e

# undetectable.ai key for the paraphraser. When empty the endpoint passes text
# through unchanged so the rest of the API still runs locally.
HUMANIZER_API_KEY=

# OpenRouter — powers source search (and the outline service next). Without it
# those endpoints return 503; the stateless tools and scrape still work.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Upstream page scraper (the octopilot backend).
UPSTREAM_SCRAPER=https://api.octopilotai.com/api/scrape

# Port to listen on.
PORT=8787
