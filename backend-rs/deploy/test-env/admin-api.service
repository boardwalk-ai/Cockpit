[Unit]
Description=Test-environment admin API (admin-api, Rust)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=gw-staging
Group=gw-staging
EnvironmentFile=/opt/admin-api/app.env
ExecStart=/opt/admin-api/bin/admin-api
Restart=always
RestartSec=3
TimeoutStopSec=15
# Notification pictures: /var/lib/admin-api/media
StateDirectory=admin-api

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
