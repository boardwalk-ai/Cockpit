# Local dev: the native Postgres 17 (or any Postgres you can create databases on).
#   createdb ghostwriter
GHOSTWRITER_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ghostwriter

# Shared octopilot DB (users, OctoCredits, keys, models). Leave unset for
# header-derived dev identities and no credits.
OCTOPILOT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/octopilot_dev

# Empty = auth disabled; the X-User-Id header is trusted (dev only).
FIREBASE_PROJECT_ID=

PORT=8791
BIND=127.0.0.1
CORS_ORIGINS=
CORS_ALLOW_LOCALHOST=true
CREDITS_ENABLED=true
CREDITS_LEDGER_TYPE=octo
LOG_FORMAT=text
