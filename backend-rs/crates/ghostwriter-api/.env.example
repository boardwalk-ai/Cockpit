# Local dev: the native Postgres 17 (or any Postgres you can create databases on).
#   createdb ghostwriter
GHOSTWRITER_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ghostwriter

# Shared octopilot DB (users, OctoCredits, keys, models). Leave unset for
# header-derived dev identities and no credits.
OCTOPILOT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/octopilot_dev

# Empty = auth disabled; the X-User-Id header is trusted (dev only).
FIREBASE_PROJECT_ID=

PORT=8791
BIND=127.0.0.1
CORS_ORIGINS=
CORS_ALLOW_LOCALHOST=true
CREDITS_ENABLED=true
CREDITS_LEDGER_TYPE=octo
LOG_FORMAT=text

# How long a run waits in memory for an answer before it is parked (let go
# until the answer comes; it never times out). Default 10 minutes.
# PARK_AFTER_MS=600000
# The run queue: runs one worker drives at once, how often it looks for work,
# and how long its claim on a run lasts without renewal.
# WORKER_SLOTS=32
# WORKER_POLL_MS=1000
# RUN_LEASE_MS=30000
# Pause between steps of the scripted driver (default 900).
# SCRIPTED_STEP_MS=900

# Who drives a run: `agent` (the model, default) or `scripted` (canned, no model).
# GHOSTWRITER_DRIVER=agent
# The Octopilot scraper service.
# SCRAPER_URL=https://api.octopilotai.com/api/scrape

# Push notifications: the Firebase service-account key file (Firebase console →
# Project settings → Service accounts → Generate new private key). Keep the file
# out of git. Unset = no push.
# FCM_SERVICE_ACCOUNT_FILE=/etc/ghostwriter/firebase-service-account.json

# Whether the scripted driver offers to humanize the essay at the end (default true).
# SCRIPTED_HUMANIZER=true
