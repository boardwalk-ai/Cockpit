# notes_db — owned by octonotes-api; migrations run automatically at startup.
# Local: the native Postgres 17, or `docker compose -f docker-compose.dev.yml up`
# (pgvector on 5435 → postgres://octonotes:octonotes@127.0.0.1:5435/octonotes).
NOTES_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/octonotes

# Shared octopilot DB (users + central OctoCredits). Local dev uses the stand-in
# from dev/octopilot_dev.sql. Leave empty to return the token identity only.
OCTOPILOT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/octopilot_dev

# Study Studio business DB (read-only). Not used until Phase 1.
STUDIO_DATABASE_URL=

# Firebase project whose ID tokens are accepted. EMPTY = auth disabled and the
# X-User-Id header is trusted (local dev only — never in production).
FIREBASE_PROJECT_ID=octopilot-ai-7b29e

# Browser origins allowed by CORS (comma-separated), plus localhost in dev.
CORS_ORIGINS=
CORS_ALLOW_LOCALHOST=true

PORT=8790
